load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("sdk_overlay_probe.bzl", "sdk_overlay_probe")

sdk_overlay_probe(
    name = "probe",
    tags = ["manual"],
)

cargo_build_script(
    name = "cargo_probe",
    srcs = ["build.rs"],
    compile_data = ["build_script.rustc_flags"],
    crate_root = "build.rs",
    edition = "2021",
    rustc_flags = ["@$(location :build_script.rustc_flags)"],
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:windows",
        "@llvm//constraints/windows/abi:msvc",
    ],
)
